{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarMethod",
   "title": "ClinvarMethod",
   "description": "A Method as ClinVar-GKM writes it for a submission's assertion method: its method type, its name and its first citation; further citations are in an extension. No id, description or aliases.",
   "$defs": {
      "ExtensionAdditionalClinvarMethodCitations": {
         "type": "object",
         "maturity": "trial use",
         "description": "The citations of an assertion method after its first, in ClinVar's order (the first is the method's reportedIn).",
         "protectedClassOf": "ClinvarMethod",
         "properties": {
            "name": {
               "type": "string",
               "const": "additionalClinvarMethodCitations",
               "description": "Must be 'additionalClinvarMethodCitations'."
            },
            "value": {
               "type": "array",
               "ordered": true,
               "items": {
                  "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarDocument"
               },
               "description": "The further citations, each a ClinvarDocument."
            }
         },
         "additionalProperties": false
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/Method"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "description": false,
            "aliases": false,
            "reportedIn": {
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarDocument",
               "description": "The method's first citation."
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "#/$defs/ExtensionAdditionalClinvarMethodCitations"
               },
               "description": "The method's further citations, in an ExtensionAdditionalClinvarMethodCitations."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
