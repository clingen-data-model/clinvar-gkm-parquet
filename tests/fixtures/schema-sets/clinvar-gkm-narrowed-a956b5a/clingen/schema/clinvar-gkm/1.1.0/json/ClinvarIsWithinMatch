{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarIsWithinMatch",
   "title": "ClinvarIsWithinMatch",
   "description": "The match characteristic of a ClinVar defining location constraint: a MappableConcept with only its type and primary coding (code `is_within`, system `ga4gh-gks-term:location-match`, no IRIs).",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "conceptType": false,
            "mappings": false,
            "primaryCoding": {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                  "code": {
                     "type": "string",
                     "const": "is_within"
                  },
                  "system": {
                     "type": "string",
                     "const": "ga4gh-gks-term:location-match"
                  }
               },
               "required": [
                  "code",
                  "system"
               ],
               "description": "The match characteristic's code and system."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
