{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarScvClassification",
   "title": "ClinvarScvClassification",
   "description": "The classification of a ClinVar SCV statement: a MappableConcept with its concept type, name, a ClinvarTermCoding, and ClinVar's description of it in an extension. No id, description, aliases or mappings.",
   "$defs": {
      "ExtensionClassificationDescription": {
         "type": "object",
         "maturity": "trial use",
         "description": "ClinVar's description of the SCV's classification: the condition, the review status and the date and submitter of the assessment, as text.",
         "protectedClassOf": "ClinvarScvClassification",
         "properties": {
            "name": {
               "type": "string",
               "const": "description",
               "description": "Must be 'description'."
            },
            "value": {
               "type": "string",
               "description": "The description text."
            }
         },
         "additionalProperties": false
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "description": false,
            "aliases": false,
            "mappings": false,
            "conceptType": {
               "type": "string",
               "const": "Classification",
               "description": "Must be 'Classification'."
            },
            "primaryCoding": {
               "description": "The classification's code and its system (the guideline that defines it).",
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarTermCoding"
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "#/$defs/ExtensionClassificationDescription"
               },
               "description": "The classification's description, in an ExtensionClassificationDescription."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
