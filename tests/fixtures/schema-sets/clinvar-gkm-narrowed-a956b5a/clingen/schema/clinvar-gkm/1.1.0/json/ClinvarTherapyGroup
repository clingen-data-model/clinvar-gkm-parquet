{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarTherapyGroup",
   "title": "ClinvarTherapyGroup",
   "description": "A record of the therapyGroup section: a TherapyGroup whose concepts are pointers to records of the therapy section. No id, name, description, aliases, extensions or concept set type.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/TherapyGroup"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "conceptSetType": false,
            "concepts": {
               "type": "array",
               "ordered": false,
               "items": {
                  "pattern": "^#/therapy/",
                  "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
               },
               "description": "The group's members, each a '#/therapy/<id>' pointer into this bundle."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
