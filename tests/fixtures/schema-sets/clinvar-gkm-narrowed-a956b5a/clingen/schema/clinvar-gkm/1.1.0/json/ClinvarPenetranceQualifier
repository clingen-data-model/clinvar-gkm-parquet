{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarPenetranceQualifier",
   "title": "ClinvarPenetranceQualifier",
   "description": "The penetrance qualifier on a ClinVar SCV proposition, derived from a low-penetrance or risk-allele classification: a MappableConcept named 'low' or 'risk', with the submitted classification in an ExtensionSubmittedClassification. No id, description, aliases, primary coding or mappings.",
   "$defs": {
      "ExtensionSubmittedClassification": {
         "type": "object",
         "maturity": "trial use",
         "description": "The SCV's submitted classification that the penetrance qualifier was derived from.",
         "protectedClassOf": "ClinvarPenetranceQualifier",
         "properties": {
            "name": {
               "type": "string",
               "const": "submittedClassification",
               "description": "Must be 'submittedClassification'."
            },
            "value": {
               "type": "string",
               "description": "The submitted classification (e.g. 'Likely risk allele')."
            }
         },
         "required": [
            "name",
            "value"
         ],
         "additionalProperties": false
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "description": false,
            "aliases": false,
            "primaryCoding": false,
            "mappings": false,
            "conceptType": {
               "type": "string",
               "const": "penetrance",
               "description": "Always 'penetrance'."
            },
            "name": {
               "type": "string",
               "enum": [
                  "low",
                  "risk"
               ],
               "description": "'low' for a pathogenic or likely pathogenic, low penetrance classification; 'risk' for an established, likely or uncertain risk allele classification."
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "#/$defs/ExtensionSubmittedClassification"
               },
               "description": "The submitted classification, in an ExtensionSubmittedClassification."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
