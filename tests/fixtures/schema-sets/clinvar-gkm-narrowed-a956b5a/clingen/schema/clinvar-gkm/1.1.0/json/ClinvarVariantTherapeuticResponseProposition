{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarVariantTherapeuticResponseProposition",
   "title": "ClinvarVariantTherapeuticResponseProposition",
   "description": "The target proposition of a therapeutic somatic clinical impact SCV's evidence line, in the propositionSomaticClinicalImpact section: a VariantTherapeuticResponseProposition whose subject is a variation pointer, whose object is a therapy or therapy group pointer and whose condition qualifier is a condition or condition set pointer, with the SCV's gene context qualifier. No name, description, aliases, extensions or allele origin qualifier.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/VariantTherapeuticResponseProposition"
      },
      {
         "type": "object",
         "properties": {
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "alleleOriginQualifier": false,
            "subject": {
               "pattern": "^#/variation/",
               "description": "The variant, a '#/variation/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "object": {
               "pattern": "^#/(therapy|therapyGroup)/",
               "description": "The drug, a '#/therapy/<id>' pointer, or a combination of drugs, a '#/therapyGroup/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "conditionQualifier": {
               "pattern": "^#/(condition|conditionSet)/",
               "description": "The disease context, a '#/condition/<id>' or '#/conditionSet/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "geneContextQualifier": {
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarGeneContextQualifier",
               "description": "The variant's gene."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
