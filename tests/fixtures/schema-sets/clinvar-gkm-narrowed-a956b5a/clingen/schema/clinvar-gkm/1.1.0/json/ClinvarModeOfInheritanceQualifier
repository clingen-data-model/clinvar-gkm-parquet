{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarModeOfInheritanceQualifier",
   "title": "ClinvarModeOfInheritanceQualifier",
   "description": "The mode of inheritance qualifier on a ClinVar SCV proposition: a MappableConcept named by the submitted mode of inheritance, with its HPO coding when the name matches an HPO term, and the submitted value in an ExtensionSubmittedModeOfInheritance. No id, description, aliases or mappings.",
   "$defs": {
      "ExtensionSubmittedModeOfInheritance": {
         "type": "object",
         "maturity": "trial use",
         "description": "The mode of inheritance the submitter gave for the SCV, as submitted.",
         "protectedClassOf": "ClinvarModeOfInheritanceQualifier",
         "properties": {
            "name": {
               "type": "string",
               "const": "submittedModeOfInheritance",
               "description": "Must be 'submittedModeOfInheritance'."
            },
            "value": {
               "type": "string",
               "description": "The submitted mode of inheritance."
            }
         },
         "required": [
            "name",
            "value"
         ],
         "additionalProperties": false
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "description": false,
            "aliases": false,
            "mappings": false,
            "conceptType": {
               "type": "string",
               "const": "modeOfInheritance",
               "description": "Always 'modeOfInheritance'."
            },
            "primaryCoding": {
               "description": "The HPO term whose label matches the submitted mode of inheritance (case-insensitively). Absent when no HPO term matches.",
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarCoding"
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "#/$defs/ExtensionSubmittedModeOfInheritance"
               },
               "description": "The submitted mode of inheritance, in an ExtensionSubmittedModeOfInheritance."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
