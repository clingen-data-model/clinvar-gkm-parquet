   "title": "ClinvarCopyNumberChange",
   "description": "A record of the copyNumberChange section: a VRS CopyNumberChange whose location is a pointer to a record of the location section. No name, description, aliases, extensions or expressions.",
   "maturity": "draft",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/vrs/2.1.1/json/CopyNumberChange"
      },
      {
         "type": "object",
         "properties": {
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "expressions": false,
            "location": {
               "pattern": "^#/location/",
               "description": "The location of the copy number change, a '#/location/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "copyChange": {
               "type": "string",
               "enum": [
                  "loss",
                  "gain"
               ],
               "description": "The copy change: 'loss' or 'gain', the only values the pipeline writes."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
