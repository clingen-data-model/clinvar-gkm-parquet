{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarDefiningAlleleConstraint",
   "title": "ClinvarDefiningAlleleConstraint",
   "description": "The constraint of a ClinvarCanonicalAllele: a DefiningAlleleConstraint whose allele is a pointer to a record of the allele section, related by `liftover_to` and `transcribed_to`.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/cat-vrs/1.1.1/json/DefiningAlleleConstraint"
      },
      {
         "type": "object",
         "properties": {
            "allele": {
               "pattern": "^#/allele/",
               "description": "The defining allele, a '#/allele/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "relations": {
               "type": "array",
               "ordered": false,
               "items": {
                  "oneOf": [
                     {
                        "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarLiftoverToRelation"
                     },
                     {
                        "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarTranscribedToRelation"
                     }
                  ]
               },
               "description": "The `liftover_to` and `transcribed_to` relations."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
