{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAggregateStatement",
   "title": "ClinvarAggregateStatement",
   "description": "A ClinVar aggregate statement \u2014 the shared base for VCV and RCV statements. Represents an aggregate classification across contributing submissions, grouping them into evidence lines by review status priority tier. Concrete aggregate statements are ClinvarVcvStatement (across all conditions for a variant) and ClinvarRcvStatement (scoped to a single condition or condition set). No name, description, aliases, method, contributions, citations, score or direct evidence.",
   "$defs": {
      "ClinvarAggregateStatementProperties": {
         "abstract": true,
         "type": "object",
         "maturity": "trial use",
         "description": "ClinVar-specific properties for aggregate (VCV and RCV) statements.",
         "protectedClassOf": "ClinvarAggregateStatement",
         "properties": {
            "proposition": {
               "pattern": "^#/(propositionPathogenicity|propositionOncogenicity|propositionSomaticClinicalImpact|propositionClinvarCustom)/",
               "description": "The aggregate proposition assessed by this VCV or RCV statement, a pointer into one of the bundle's proposition sections. Uses the same proposition types as SCV statements. The proposition at the aggregate level represents the consensus or highest-priority classification across contributing submissions.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "classification": {
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAggregateClassification",
               "description": "The aggregate classification."
            },
            "strength": {
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAggregateStrength",
               "description": "The strength of the aggregate classification (e.g. 'Likely'), when it has one."
            },
            "quality": {
               "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarQuality",
               "description": "The quality of the aggregate, from the submission level of its submissions."
            },
            "hasEvidenceLines": {
               "type": "array",
               "ordered": false,
               "items": {
                  "pattern": "^#/evidenceLine/",
                  "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
               },
               "description": "The statement's evidence lines, each a '#/evidenceLine/<id>' pointer into this bundle: always its contributing evidence line and, at the priority and aggregate layers, a non-contributing evidence line when there are non-contributing items. The evidence line's items point to the SCV statements (classification layer) or to the lower-layer aggregate statements (priority and aggregate layers)."
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "#/$defs/ExtensionClinvarReviewStatus"
               },
               "description": "The aggregate review status, in an ExtensionClinvarReviewStatus. Absent on the somatic priority-layer statements."
            }
         }
      },
      "ExtensionClinvarReviewStatus": {
         "type": "object",
         "maturity": "trial use",
         "description": "The aggregate review status for a VCV or RCV statement. Reflects the highest review status among contributing submissions (e.g., \"practice guideline\", \"reviewed by expert panel\", \"criteria provided, multiple submitters, no conflicts\").",
         "protectedClassOf": "ClinvarAggregateStatement",
         "properties": {
            "name": {
               "type": "string",
               "const": "clinvarReviewStatus",
               "description": "Must be 'clinvarReviewStatus'."
            },
            "value": {
               "type": "string",
               "enum": [
                  "practice guideline",
                  "reviewed by expert panel",
                  "criteria provided, conflicting classifications",
                  "criteria provided, multiple submitters, no conflicts",
                  "criteria provided, single submitter",
                  "no assertion criteria provided",
                  "no classification provided",
                  "flagged submission"
               ],
               "description": "The aggregate review status."
            }
         },
         "additionalProperties": false
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/Statement"
      },
      {
         "$ref": "#/$defs/ClinvarAggregateStatementProperties"
      },
      {
         "type": "object",
         "properties": {
            "name": false,
            "description": false,
            "aliases": false,
            "specifiedBy": false,
            "contributions": false,
            "reportedIn": false,
            "score": false,
            "hasEvidence": false
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
