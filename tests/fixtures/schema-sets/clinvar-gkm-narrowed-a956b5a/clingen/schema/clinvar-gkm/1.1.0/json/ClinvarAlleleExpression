{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAlleleExpression",
   "title": "ClinvarAlleleExpression",
   "description": "An expression of a ClinvarAllele: an SPDI, HGVS or gnomAD syntax and the expression text. No id, extensions or syntax version.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/vrs/2.1.1/json/Expression"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "extensions": false,
            "syntax_version": false,
            "syntax": {
               "type": "string",
               "enum": [
                  "spdi",
                  "gnomad",
                  "hgvs.g",
                  "hgvs.m",
                  "hgvs.c",
                  "hgvs.n",
                  "hgvs.r",
                  "hgvs.p"
               ],
               "description": "`spdi`, `gnomad`, or `hgvs.` and the HGVS type letter of the expression."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
