{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarSequenceLocation",
   "title": "ClinvarSequenceLocation",
   "description": "A record of the location section: a VRS SequenceLocation whose sequence reference is a pointer to a record of the sequenceReference section. No name, description, aliases, extensions or sequence.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/vrs/2.1.1/json/SequenceLocation"
      },
      {
         "type": "object",
         "properties": {
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "sequence": false,
            "sequenceReference": {
               "pattern": "^#/sequenceReference/",
               "description": "The reference sequence for the location, a '#/sequenceReference/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
