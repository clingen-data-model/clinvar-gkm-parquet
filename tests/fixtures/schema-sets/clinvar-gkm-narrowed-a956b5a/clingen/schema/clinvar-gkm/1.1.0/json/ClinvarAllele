{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAllele",
   "title": "ClinvarAllele",
   "description": "A record of the allele section: a VRS Allele with its name and expressions, whose location is a pointer to a record of the location section. No description, aliases or extensions.",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/vrs/2.1.1/json/Allele"
      },
      {
         "type": "object",
         "properties": {
            "description": false,
            "aliases": false,
            "extensions": false,
            "location": {
               "pattern": "^#/location/",
               "description": "The location of the allele, a '#/location/<id>' pointer into this bundle.",
               "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
            },
            "state": {
               "properties": {
                  "id": false,
                  "name": false,
                  "description": false,
                  "aliases": false,
                  "extensions": false,
                  "length": {
                     "type": "integer",
                     "description": "The length of the reference sequence the state repeats."
                  }
               },
               "description": "The allele's state: a LiteralSequenceExpression or a ReferenceLengthExpression (whose length is an integer). No id, name, description, aliases or extensions."
            },
            "expressions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAlleleExpression"
               },
               "description": "The allele's SPDI, HGVS and gnomAD expressions."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
