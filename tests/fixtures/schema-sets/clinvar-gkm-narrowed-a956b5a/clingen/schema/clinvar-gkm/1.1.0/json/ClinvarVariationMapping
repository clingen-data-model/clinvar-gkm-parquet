   "allOf": [
      {
         "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarConceptMapping"
      },
      {
         "type": "object",
         "properties": {
            "relation": {
               "type": "string",
               "enum": [
                  "exactMatch",
                  "closeMatch",
                  "relatedMatch"
               ],
               "description": "`exactMatch` for the ClinVar variation, `closeMatch` for a ClinGen allele, `relatedMatch` for every other cross-reference."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
