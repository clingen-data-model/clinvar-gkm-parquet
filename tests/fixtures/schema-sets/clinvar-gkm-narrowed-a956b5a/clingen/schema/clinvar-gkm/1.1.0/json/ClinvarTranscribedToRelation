{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarTranscribedToRelation",
   "title": "ClinvarTranscribedToRelation",
   "description": "The `transcribed_to` relation of a ClinVar defining allele constraint: a MappableConcept with only its type and primary coding (code `transcribed_to`, system `http://www.sequenceontology.org/` and the term's IRI).",
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
      },
      {
         "type": "object",
         "properties": {
            "id": false,
            "name": false,
            "description": false,
            "aliases": false,
            "extensions": false,
            "conceptType": false,
            "mappings": false,
            "primaryCoding": {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                  "code": {
                     "type": "string",
                     "const": "transcribed_to"
                  },
                  "system": {
                     "type": "string",
                     "const": "http://www.sequenceontology.org/"
                  },
                  "iris": {
                     "type": "array",
                     "ordered": false,
                     "items": {
                        "type": "string",
                        "const": "http://www.sequenceontology.org/browser/current_release/term/transcribed_to"
                     }
                  }
               },
               "required": [
                  "code",
                  "system"
               ],
               "description": "The relation's code, system and IRI."
            }
         }
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
