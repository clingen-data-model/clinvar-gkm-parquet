{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/Allele",
  "title": "Allele",
  "description": "Allele, narrowed to what the producer emits.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "syntax": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "location": {
      "type": "string",
      "pattern": "^#/(location)/"
    },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "LiteralSequenceExpression"
            },
            "sequence": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ReferenceLengthExpression"
            },
            "length": {
              "type": "integer"
            },
            "sequence": {
              "type": "string"
            },
            "repeatSubunitLength": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "LengthExpression"
            },
            "length": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
