{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/CopyNumberCount",
  "title": "CopyNumberCount",
  "description": "CopyNumberCount, narrowed to what the producer emits.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "pattern": "^#/(location)/"
    },
    "copies": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
