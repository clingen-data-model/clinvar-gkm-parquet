{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/CategoricalVariant",
  "title": "CategoricalVariant",
  "description": "CategoricalVariant, narrowed to what the producer emits.",
  "$defs": {
    "Relation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "primaryCoding": {
          "$ref": "/clingen/schema/clinvar-gkm/9.9.0/json/Coding#/$defs/CodeSystemIris"
        }
      },
      "additionalProperties": false
    },
    "AlleleConstraint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "allele": {
          "type": "string",
          "pattern": "^#/(allele)/"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        }
      },
      "additionalProperties": false
    },
    "LocationConstraint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "pattern": "^#/(location)/"
        },
        "matchCharacteristic": {
          "$ref": "#/$defs/Relation"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        }
      },
      "additionalProperties": false
    },
    "CountConstraint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "copies": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "ChangeConstraint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "copyChange": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExpressionWithExtensions": {
      "type": "object",
      "properties": {
        "syntax": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "ext0"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "ext1"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "HgvsListItem": {
      "type": "object",
      "properties": {
        "nucleotideExpression": {
          "$ref": "#/$defs/ExpressionWithExtensions"
        },
        "nucleotideType": {
          "type": "string"
        },
        "maneSelect": {
          "type": "boolean"
        },
        "manePlus": {
          "type": "boolean"
        },
        "proteinExpression": {
          "type": "object",
          "properties": {
            "syntax": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "molecularConsequence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "system": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "iris": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "GeneListItem": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "pattern": "^#/(gene)/"
        },
        "relationship_type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/AlleleConstraint"
          },
          {
            "$ref": "#/$defs/LocationConstraint"
          },
          {
            "$ref": "#/$defs/CountConstraint"
          },
          {
            "$ref": "#/$defs/ChangeConstraint"
          }
        ]
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#/(allele|copyNumberCount|copyNumberChange)/"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "const": "ext0"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "const": "ext1"
              },
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/HgvsListItem"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "const": "ext2"
              },
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/GeneListItem"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coding": {
            "$ref": "/clingen/schema/clinvar-gkm/9.9.0/json/Coding#/$defs/CodeSystemIris"
          },
          "relation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
