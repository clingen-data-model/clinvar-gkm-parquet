{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/clinvar-gkm-bundle.schema.json",
  "title": "A made-up bundle version that meets ADR 0006 §4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "9.9.0"
    },
    "sequenceReference": {
      "type": "object",
      "title": "sequenceReference",
      "description": "SequenceReference records.",
      "patternProperties": {
        "^SQ\\..+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/SequenceReference"
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "title": "location",
      "description": "SequenceLocation records.",
      "patternProperties": {
        "^ga4gh:SL\\..+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/SequenceLocation"
        }
      },
      "additionalProperties": false
    },
    "allele": {
      "type": "object",
      "title": "allele",
      "description": "Allele records.",
      "patternProperties": {
        "^ga4gh:VA\\..+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/Allele"
        }
      },
      "additionalProperties": false
    },
    "copyNumberCount": {
      "type": "object",
      "title": "copyNumberCount",
      "description": "CopyNumberCount records.",
      "patternProperties": {
        "^ga4gh:CN\\..+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/CopyNumberCount"
        }
      },
      "additionalProperties": false
    },
    "copyNumberChange": {
      "type": "object",
      "title": "copyNumberChange",
      "description": "CopyNumberChange records.",
      "patternProperties": {
        "^ga4gh:CX\\..+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/CopyNumberChange"
        }
      },
      "additionalProperties": false
    },
    "gene": {
      "type": "object",
      "title": "gene",
      "description": "Gene records.",
      "patternProperties": {
        "^ncbigene:[0-9]+$": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/Gene"
        }
      },
      "additionalProperties": false
    },
    "variation": {
      "type": "object",
      "title": "variation",
      "description": "CategoricalVariant records.",
      "patternProperties": {
        "^clinvar:[0-9]+$": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/CategoricalVariant"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "title": "condition",
      "description": "Condition records.",
      "patternProperties": {
        "^clinvar\\.trait:[0-9]+$": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/Condition"
        }
      },
      "additionalProperties": false
    },
    "conditionSet": {
      "type": "object",
      "title": "conditionSet",
      "description": "ConditionSet records.",
      "patternProperties": {
        "^clinvar\\.(trait[sS]et|conditionset):.+": {
          "$ref": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/ConditionSet"
        }
      },
      "additionalProperties": false
    }
  }
}
