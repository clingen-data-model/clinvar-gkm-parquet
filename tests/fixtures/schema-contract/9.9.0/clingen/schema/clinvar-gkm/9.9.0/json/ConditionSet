{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/clingen/schema/clinvar-gkm/9.9.0/json/ConditionSet",
  "title": "ConditionSet",
  "description": "ConditionSet, narrowed to what the producer emits.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "conceptSetType": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#/(condition|conditionSet)/"
      }
    },
    "membershipOperator": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
