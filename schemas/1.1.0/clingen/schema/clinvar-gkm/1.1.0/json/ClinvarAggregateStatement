{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarAggregateStatement",
   "title": "ClinvarAggregateStatement",
   "description": "A ClinVar aggregate statement \u2014 the shared base for VCV and RCV statements. Represents an aggregate classification across contributing submissions, grouping them into evidence lines by review status priority tier. Concrete aggregate statements are ClinvarVcvStatement (across all conditions for a variant) and ClinvarRcvStatement (scoped to a single condition or condition set).",
   "$defs": {
      "ExtensionClinvarReviewStatus": {
         "type": "object",
         "maturity": "trial use",
         "description": "The aggregate review status for a VCV or RCV statement. Reflects the highest review status among contributing submissions (e.g., \"practice guideline\", \"reviewed by expert panel\", \"criteria provided, multiple submitters, no conflicts\").",
         "protectedClassOf": "ClinvarAggregateStatement",
         "properties": {
            "name": {
               "type": "string",
               "const": "clinvarReviewStatus",
               "description": "Must be 'clinvarReviewStatus'."
            },
            "value": {
               "type": "string",
               "enum": [
                  "practice guideline",
                  "reviewed by expert panel",
                  "criteria provided, conflicting classifications",
                  "criteria provided, multiple submitters, no conflicts",
                  "criteria provided, single submitter",
                  "no assertion criteria provided",
                  "no classification provided",
                  "no assertion provided",
                  "flagged submission"
               ],
               "description": "The aggregate review status."
            }
         },
         "additionalProperties": false
      },
      "ClinvarAggregateStatementProperties": {
         "abstract": true,
         "type": "object",
         "maturity": "trial use",
         "description": "ClinVar-specific properties for aggregate (VCV and RCV) statements.",
         "protectedClassOf": "ClinvarAggregateStatement",
         "properties": {
            "proposition": {
               "description": "The aggregate proposition assessed by this VCV or RCV statement. Uses the same proposition types as SCV statements. The proposition at the aggregate level represents the consensus or highest-priority classification across contributing submissions.",
               "oneOf": [
                  {
                     "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarProposition"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ]
            },
            "hasEvidenceLines": {
               "type": "array",
               "ordered": false,
               "items": {
                  "anyOf": [
                     {
                        "$ref": "/ga4gh/schema/va-spec/1.1.0/json/EvidenceLine"
                     },
                     {
                        "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                     }
                  ]
               },
               "description": "Evidence lines grouping contributing submissions by review status priority tier. Each evidence line contains nested sub-statements (classification layer) or SCV references (aggregate contribution layer). Tiers are: practice guideline (PG), expert panel (EP), criteria provided (CP), no criteria provided (NOCP), no classification provided (NOCL), and flagged submission (FLAG)."
            },
            "extensions": {
               "type": "array",
               "ordered": false,
               "items": {
                  "oneOf": [
                     {
                        "$ref": "#/$defs/ExtensionClinvarReviewStatus"
                     }
                  ]
               },
               "description": "Aggregate-level extensions including the overall review status."
            }
         }
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/Statement"
      },
      {
         "$ref": "#/$defs/ClinvarAggregateStatementProperties"
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
