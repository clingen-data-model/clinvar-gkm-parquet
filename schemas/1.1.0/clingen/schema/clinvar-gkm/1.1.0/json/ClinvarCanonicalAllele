      },
      {
         "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarCategoricalVariant#/$defs/ClinvarCategoricalVariantProperties"
      },
      {
         "required": [
            "constraints"
         ],
         "properties": {
            "constraints": {
               "contains": {
                  "type": "object",
                  "required": [
                     "type"
                  ],
