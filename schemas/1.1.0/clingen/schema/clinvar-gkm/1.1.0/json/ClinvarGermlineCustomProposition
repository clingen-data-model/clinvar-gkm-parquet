{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarGermlineCustomProposition",
   "title": "ClinvarGermlineCustomProposition",
   "description": "A custom proposition type for ClinVar germline submissions that do not have a corresponding GA4GH VA-Spec proposition type. Includes ClinVar submission categories such as \"risk factor\", \"protective\", \"drug response\", \"affects\", \"association\", \"confers sensitivity\", \"other\", \"not provided\", and \"conflicting data from submitters\". These custom proposition types are used to represent variant-condition associations in Clin",
   "$defs": {
      "ClinvarGermlineCustomPropositionProperties": {
         "abstract": true,
         "type": "object",
         "maturity": "trial use",
         "description": "ClinVar-specific properties for germline custom propositions.",
         "protectedClassOf": "ClinvarGermlineCustomProposition",
         "properties": {
            "subject": {
               "oneOf": [
                  {
                     "$ref": "/ga4gh/schema/vrs/2.1.1/json/MolecularVariation"
                  },
                  {
                     "$ref": "/ga4gh/schema/cat-vrs/1.1.1/json/CategoricalVariant"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ],
               "description": "A variant that is the subject of the Proposition."
            },
            "object": {
               "oneOf": [
                  {
                     "$ref": "/ga4gh/schema/va-spec/1.1.0/json/Condition"
                  },
                  {
                     "$ref": "/ga4gh/schema/va-spec/1.1.0/json/ConditionSet"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ],
               "description": "The condition for which the variant is associated."
            },
            "geneContextQualifier": {
               "oneOf": [
                  {
                     "$ref": "/clingen/schema/clinvar-gkm/1.1.0/json/ClinvarGeneContextQualifier"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ],
               "description": "Reports a gene impacted by the variant, which may contribute to the association described in the Proposition."
            },
            "modeOfInheritanceQualifier": {
               "oneOf": [
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ],
               "description": "Reports a pattern of inheritance expected for the effect of the variant."
            },
            "penetranceQualifier": {
               "oneOf": [
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/MappableConcept"
                  },
                  {
                     "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/iriReference"
                  }
               ],
               "description": "Reports the penetrance of the effect - the extent to which the variant impact is expressed by carriers."
            }
         }
      }
   },
   "maturity": "trial use",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/va-spec/1.1.0/json/SubjectVariantProposition"
      },
      {
         "$ref": "#/$defs/ClinvarGermlineCustomPropositionProperties"
      }
   ],
   "type": "object",
   "unevaluatedProperties": false
}
